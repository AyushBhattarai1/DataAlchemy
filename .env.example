# DataAlchemy Environment Configuration

# Set to "true" to use fast deterministic mock LLM provider (ideal for testing or low-resource machines)
USE_MOCK_AI=false

# Hugging Face open-weight model name or local path
DATAALCHEMY_HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Environment mode: "development", "test", or "production"
DATAALCHEMY_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000
